# Anthropic API Key
# Dapatkan di: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App URL (isi setelah deploy ke Vercel)
NEXT_PUBLIC_APP_URL=https://echocanvas.vercel.app

# JWT Secret untuk auth (buat string random panjang)
JWT_SECRET=ganti-dengan-string-random-minimal-32-karakter

# Optional: Upstash Redis untuk rate limiting
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
